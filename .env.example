# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development

# Service APIs
CALENDAR_SERVICE_API=your_calendar_service_api_url
AUTHENTICATION_SERVICE_API=your_authentication_service_api_url
BUCKET_SERVICE_API=your_bucket_service_api_url
AI_SERVICE_API=your_ai_service_api_url
API_BASE_URL=your_api_base_url
VECTOR_SEARCH_API=your_vectorsearch_service_api_url

# API Keys
PLATINUM_LIST_API_KEY=your_platinum_list_api_key
TICKET_MASTER_API_KEY=your_ticket_master_api_key
TICKETMASTER_API_KEY=your_ticketmaster_api_key
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key
HOTEL_API_KEY=your_hotel_api_key
HOTEL_API_KEY_USERNAME=your_hotel_api_username

# BLIP Configuration
BLIP_API_KEY=your_blip_api_key
BLIP_WEBHOOK_SECRET=your_blip_webhook_secret
BLIP_WEBHOOK_URL=your_blip_webhook_url
BLIP_API_URL=your_blip_api_url
BLIP_ENCRYPTED_KEY=your_blip_encrypted_key
BLIP_CALLER_PHONE_NUMBER=your_blip_caller_phone_number

# Google Services
GOOGLE_API_RADIUS=your_google_api_radius
GOOGLE_APPLICATION_CREDENTIALS=your_google_application_credentials_path

# Model Configuration
MODEL_NAME=your_model_name
API_VERSION=your_api_version

# Cosmos DB
COSMOS_ENDPOINT=your_cosmos_endpoint
COSMOS_KEY=your_cosmos_key
COSMOS_DATABASE=your_cosmos_database

# LangChain Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=your_langchain_endpoint
LANGCHAIN_PROJECT=your_langchain_project
LANGCHAIN_API_KEY=your_langchain_api_key

# Other APIs
FIRECRAWL_API_KEY=your_firecrawl_api_key
CALENDAR_SERVICE_TOKEN=your_calendar_service_token
DUFFEL_API_KEY_LIVE=your_duffel_api_key_live
PERSISTENCE_MONGODB_URI=your_mongodb_connection_string
DEFAULT_PHONE_NUMBER_TO_CALL=your_default_phone_number

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_SDK=your_firebase_service_account_json_string

# MCP Server URLs
GOOGLE_MAPS_MCP_URL=https://google-maps-container-app.redsky-e0008d3b.uaenorth.azurecontainerapps.io/stream
CALENDAR_TODO_MCP_URL=https://calendar-todo-mcp-container-app.redsky-e0008d3b.uaenorth.azurecontainerapps.io/stream
TICKETMASTER_MCP_URL=https://ticketmaster-mcp-container-app.redsky-e0008d3b.uaenorth.azurecontainerapps.io/sse
BROWSER_USE_MCP_URL=https://browser-use-mcp-container-app.redsky-e0008d3b.uaenorth.azurecontainerapps.io/stream
PLATINUM_MCP_URL=https://platinum-mcp-container-app.redsky-e0008d3b.uaenorth.azurecontainerapps.io/sse
RATEHAWK_MCP_URL=https://ratehawk-mcp-container-app.redsky-e0008d3b.uaenorth.azurecontainerapps.io/stream
AI_CONTAINER_WEBHOOK_URL=https://ai-container-app.redsky-e0008d3b.uaenorth.azurecontainerapps.io

# Server Configuration
PORT=3000
