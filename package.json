{
    "name": "ai-v2",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "npx tsx --env-file=.env src/server.ts",
        "star": "npx tsx src/server.ts",
        "starr": "cross-env NODE_OPTIONS='--dns-result-order=ipv4first' npx tsx src/server.ts",
        "dev": "npx tsx --env-file=.env --watch  src/server.ts",
        "build": "tsc",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "inspector": "npx @modelcontextprotocol/inspector",
        "deploy": "bash deploy.sh",
        "logs": "az containerapp logs show -n agenticai-container-app -g ContainerApps_RG --follow",
        "ssh": "az containerapp exec --name agenticai-container-app --resource-group ContainerApps_RG"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@langchain/core": "^0.3.43",
        "@langchain/langgraph": "^0.2.59",
        "@langchain/langgraph-checkpoint-mongodb": "^0.0.6",
        "@langchain/langgraph-swarm": "^0.0.3",
        "@langchain/mcp-adapters": "^0.4.5",
        "@langchain/openai": "^0.5.0",
        "axios": "^1.10.0",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "firebase-admin": "^13.4.0",
        "gaxios": "^7.1.0",
        "google-auth-library": "^10.1.0",
        "googleapis": "^150.0.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.13.0",
        "morgan": "^1.10.0",
        "nodemon": "^3.1.9",
        "pkce-challenge": "^3.0.0",
        "winston": "^3.17.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.13.13",
        "@typescript-eslint/eslint-plugin": "^8.28.0",
        "@typescript-eslint/parser": "^8.28.0",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.2"
